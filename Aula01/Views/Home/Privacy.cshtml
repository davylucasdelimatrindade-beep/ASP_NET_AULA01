@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="card">
    <div class="card-body">
        <h5 class="card-title">Informações da sessão</h5>
        <p><strong>Nome:</strong>@ViewBag.UsuarioLogado</p>
        <p><strong>Endereço:</strong>@ViewBag.DataAcesso</p>
        <p><strong>Email:</strong>@ViewBag.NivelAcesso</p>
    </div>

<p>Use this page to detail your site's privacy policy.</p>
